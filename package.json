{
  "name": "danmaku-player",
  "version": "0.1.0",
  "description": "支持 XML、ASS 弹幕和精确延迟调整的本地视频播放器",
  "author": "Metal Neko",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-vinext.mjs dev",
    "build": "node scripts/run-vinext.mjs build",
    "start": "node scripts/run-vinext.mjs start",
    "desktop:build": "vite build --config vite.desktop.config.ts",
    "desktop:dev": "tauri dev",
    "appimage": "node scripts/package-desktop.mjs appimage",
    "linux:native": "node scripts/package-native.mjs",
    "test": "npm run build && npm run test:media:build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern desktop-dist --ignore-pattern src-tauri --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "icons:sync": "node scripts/sync-icons.mjs",
    "predev": "npm run icons:sync",
    "prebuild": "npm run icons:sync",
    "predesktop:build": "npm run icons:sync",
    "windows": "node scripts/package-desktop.mjs nsis",
    "macos": "node scripts/package-desktop.mjs dmg",
    "test:media": "npm run test:media:build && node --test tests/media-server.test.mjs",
    "test:desktop": "npm run desktop:prepare && cargo build --manifest-path src-tauri/Cargo.toml && node tests/desktop-playback.cjs",
    "desktop:prepare": "npm run desktop:build && node scripts/bundle-media.cjs",
    "desktop:package": "node scripts/package-desktop.mjs",
    "test:media:build": "cargo build --manifest-path src-tauri/Cargo.toml -p danmaku-media --bin media-harness"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "drizzle-orm": "0.45.2",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
